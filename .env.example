# Copy to .env (git-ignored) and fill in. Placeholders only - never commit real values.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/cicd_agent
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>
DB_POOL_SIZE=10

# --- Kubernetes connection ---
# AUTO | KUBECONFIG | IN_CLUSTER
KUBERNETES_AUTH_MODE=AUTO
# Optional: defaults to $KUBECONFIG, then ~/.kube/config
KUBERNETES_KUBECONFIG_PATH=
# Optional: kubeconfig context name, defaults to current-context
KUBERNETES_CONTEXT=
KUBERNETES_CONNECTION_TIMEOUT_MS=5000
KUBERNETES_REQUEST_TIMEOUT_MS=10000

# --- Tekton monitoring ---
MONITORING_ENABLED=true
# Comma-separated namespaces where PipelineRuns/TaskRuns are created
MONITORING_NAMESPACES=<tekton-namespace>
MONITORING_POLLING_INTERVAL_MS=15000
MONITORING_INITIAL_DELAY_MS=5000
MONITORING_LABEL_SELECTOR=
MONITORING_PAGE_SIZE=200
TEKTON_API_GROUP=tekton.dev
TEKTON_API_VERSION=v1

# --- Failure evidence collection (Phase 2.1) ---
# Needs "get" on pods and pods/log in every monitored namespace
EVIDENCE_ENABLED=false
EVIDENCE_POLLING_INTERVAL_MS=30000
EVIDENCE_INITIAL_DELAY_MS=20000
EVIDENCE_LOOKBACK_HOURS=24
EVIDENCE_BATCH_SIZE=10
EVIDENCE_MAX_CONCURRENT_LOG_REQUESTS=2
EVIDENCE_MAX_LOG_LINES=500
EVIDENCE_MAX_CONTAINER_LOG_BYTES=65536
EVIDENCE_MAX_TASKRUN_LOG_BYTES=262144
EVIDENCE_RETENTION_DAYS=14
EVIDENCE_MAX_FETCH_ATTEMPTS=5
EVIDENCE_RETRY_BACKOFF_SECONDS=60
EVIDENCE_REQUEST_TIMEOUT_MS=10000

# --- HTTP / frontend ---
SERVER_PORT=8080
# Comma-separated Angular frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Observability ---
LOG_LEVEL=INFO
# Set to ecs, logstash or gelf for JSON console logs
LOGGING_STRUCTURED_FORMAT_CONSOLE=
HEALTH_SHOW_DETAILS=always
